{
  "schemaVersion": 1,
  "title": "Technical architecture evidence rubric",
  "method": "A signal earns its points only when the pinned source checkout contains at least one matching implementation token. The scanner records the file and line as evidence. This is an auditable architecture inventory, not a claim that a token alone proves runtime quality.",
  "dimensions": [
    {
      "id": "global-planning",
      "label": "Global planning and pace model",
      "maxPoints": 15,
      "signals": [
        {"id": "offline-solver", "label": "Offline/global optimal solver", "points": 5, "patterns": ["class\\s+GlobalTimeOptimalEngine", "new\\s+GlobalTimeOptimalEngine", "class\\s+TrackGrid", "new\\s+TrackGrid", "class\\s+RacingLine", "solvePaceProfile", "computeLine"]},
        {"id": "speed-profile", "label": "Forward/backward or reachable speed profile", "points": 3, "patterns": ["speedProfiles\\s*=", "computeSpeedEnvelope\\s*\\(", "forwardBackward", "integrateSpeedProfile", "profileSpeed", "cornerSpeed"]},
        {"id": "cost-to-go", "label": "Value function or cost-to-go representation", "points": 4, "patterns": ["costToGo", "valueFunction", "this\\.J\\b", "LineCache\\s*\\.", "responseRisk", "trajectoryCost"]},
        {"id": "continuous-refinement", "label": "Continuous line refinement or smoothing", "points": 3, "patterns": ["coordinateDescent", "refine[A-Z]", "smoothLine", "raisedCosine", "smoothTrack", "catmullRom"]}
      ]
    },
    {
      "id": "runtime-planning",
      "label": "Runtime planning and control separation",
      "maxPoints": 15,
      "signals": [
        {"id": "trajectory-search", "label": "Candidate trajectory/lattice search", "points": 5, "patterns": ["class\\s+TrajectoryPlanner", "class\\s+FrenetLatticePlanner", "class\\s+Lattice", "proposalsFor\\s*\\(", "trajectoryPlanner\\.plan\\s*\\(", "class\\s+TacticalPlanner", "trackMPC", "predictChassis"]},
        {"id": "control-layer", "label": "Dedicated steering/pedal control layer", "points": 4, "patterns": ["class\\s+VehicleController", "class\\s+Driver", "class\\s+PaceOptimizer", "class\\s+AdaptiveDriver", "computeSteering\\s*\\(", "computePedals\\s*\\("]},
        {"id": "multi-rate", "label": "Explicit multi-rate or budgeted replanning", "points": 3, "patterns": ["class\\s+PlanBudget", "planHz\\s*=", "combatHz\\s*=", "planTimer\\s*\\+=", "trajectoryIntervalTicks", "step\\s*\\(dt"]},
        {"id": "commitment-state", "label": "Persistent plan or maneuver commitment state", "points": 3, "patterns": ["committed\\s*[:=]", "currentPlan\\s*=", "planPhaseAge", "oneMoveLocked", "phaseChanged", "commit\\s*="]}
      ]
    },
    {
      "id": "racecraft-traffic",
      "label": "Racecraft and traffic reasoning",
      "maxPoints": 15,
      "signals": [
        {"id": "tactical-vocabulary", "label": "Attack, defense, and overtaking tactics", "points": 5, "patterns": ["_attack\\s*\\(", "attackTargetId", "mode\\s*:\\s*['\\x27]?PASS", "DIVEBOMB", "SWITCHBACK", "SLINGSHOT", "responses\\s*\\(", "intent\\s*===\\s*['\"](?:DEFEND|OVERTAKE|PASS|HOLD)", "responseRisk"]},
        {"id": "opponent-prediction", "label": "Opponent prediction, occupancy, or TTC", "points": 4, "patterns": ["_predictOpponent", "traffic\\.entries", "occupancy", "minimumClearance", "\\bttc\\s*=", "timeToCollision", "responses\\s*\\(", "brakeStrength"]},
        {"id": "defense-rules", "label": "Defensive commitment or anti-weave rules", "points": 3, "patterns": ["oneMoveLocked", "commitCorner", "defenseMode", "BREAK_TOW", "defensiveDirection", "defendLane", "blockLine"]},
        {"id": "recovery-tactics", "label": "Recovery and rejoin behavior", "points": 3, "patterns": ["marshalRecoverTo", "offTrack\\s*=", "RECOVER", "PHYSICAL_REJOIN", "wasRecovering"]}
      ]
    },
    {
      "id": "vehicle-dynamics",
      "label": "Vehicle dynamics and actuation coupling",
      "maxPoints": 15,
      "signals": [
        {"id": "friction-coupling", "label": "Friction-circle, MPCC, or coupled slip handling", "points": 6, "patterns": ["class\\s+CoupledMPCCController", "frictionCircle", "frictionEllipse", "slipAngle\\s*[:=]", "slipSlope", "trackMPC", "slipPower"]},
        {"id": "longitudinal-lateral", "label": "Coupled steering and longitudinal control", "points": 4, "patterns": ["computePedals\\s*\\(", "yawRate\\s*[:=]", "lateralAccel\\s*[:=]", "steerAngle\\s*[:=]", "steer\\s*="]},
        {"id": "contact-aero", "label": "Contact, collision, wake, or aero interaction model", "points": 5, "patterns": ["class\\s+CombatDynamicsEngine", "updateAerodynamicWakes\\s*\\(", "resolveVehicleCollisions\\s*\\(", "stepContacts\\s*\\(", "wakes\\s*\\(", "collisions\\s*\\("]}
      ]
    },
    {
      "id": "field-coordination",
      "label": "Whole-field coordination",
      "maxPoints": 10,
      "signals": [
        {"id": "central-arbitration", "label": "Central field arbitration or compatible plan allocation", "points": 6, "patterns": ["class\\s+AIRaceDirector", "_planField\\s*\\(", "trajectoriesConflict\\s*\\(", "allocatedTrajectories", "context\\.projections", "class\\s+Session", "new\\s+Session"]},
        {"id": "shared-awareness-budget", "label": "Shared field awareness or planning budget", "points": 4, "patterns": ["class\\s+PlanBudget", "new\\s+TrafficAwareness", "this\\.agents", "field\\s*[:=]", "context\\.order"]}
      ]
    },
    {
      "id": "safety-recovery",
      "label": "Feasibility, safety, and fallback behavior",
      "maxPoints": 10,
      "signals": [
        {"id": "feasibility-gates", "label": "Road legality and collision/dynamic feasibility gates", "points": 5, "patterns": ["roadLegal\\s*:", "collisionFree\\s*:", "dynamicallyFeasible\\s*:", "minimumClearance\\s*:", "frictionCircle", "halfCarInside"]},
        {"id": "fallbacks", "label": "Fallback plans and finite-value guards", "points": 3, "patterns": ["fallback\\s*=", "Number\\.isFinite", "finite\\s*=", "clamp\\s*\\("]},
        {"id": "track-limit-recovery", "label": "Track-limit and off-track handling", "points": 2, "patterns": ["offTrack\\s*=", "marshalRecoverTo", "recoveryTimer", "offtrack"]}
      ]
    },
    {
      "id": "integration-closure",
      "label": "Architecture integration closure",
      "maxPoints": 10,
      "signals": [
        {"id": "planner-wired", "label": "Planner is called from an active controller path", "points": 4, "patterns": ["trajectoryPlanner\\.plan\\s*\\(", "planner\\.plan\\s*\\(", "proposalsFor\\s*\\(", "lattice\\.search\\s*\\(", "planner\\.update\\s*\\(", "driver\\.planner"]},
        {"id": "tactics-wired", "label": "Racecraft/tactical layer is called from the controller path", "points": 3, "patterns": ["combatEngine\\.evaluate\\s*\\(", "racecraft\\.update\\s*\\(", "tacticalIntents\\s*\\(", "responses\\s*\\(", "driver\\.update\\s*\\("]},
        {"id": "actuation-wired", "label": "Actuation output is handed to vehicle controls", "points": 3, "patterns": ["computeSteering\\s*\\(", "computePedals\\s*\\(", "controller\\.compute\\s*\\(", "setControls\\s*\\(", "car\\.controls\\s*="]}
      ]
    },
    {
      "id": "observability-validation",
      "label": "Observability and validation surface",
      "maxPoints": 10,
      "signals": [
        {"id": "telemetry", "label": "Debug state or telemetry export", "points": 3, "patterns": ["debugState\\s*=", "telemetry\\s*=", "debugEnabled\\s*=", "exportTelemetry"]},
        {"id": "fixed-step", "label": "Explicit fixed-step or deterministic timing", "points": 3, "patterns": ["const\\s+DT\\s*=", "1 / 120", "1 / 400", "physicsHz\\s*="]},
        {"id": "test-harness", "label": "Dedicated automated test surface", "points": 4, "auto": "testFiles"}
      ]
    }
  ],
  "closureChecks": [
    {
      "id": "mpcc-actuation-closure",
      "label": "Coupled MPCC is used in the active control path",
      "detect": "mpcc",
      "severity": "warning",
      "explanation": "The repository may contain a substantial MPCC implementation that is instantiated or documented but not called to produce live controls."
    },
    {
      "id": "global-profile-closure",
      "label": "Global profile is sampled by runtime control",
      "detect": "globalProfile",
      "severity": "info",
      "explanation": "A global solver is most valuable when its profile reaches the runtime planner/controller, not only an offline file."
    },
    {
      "id": "combat-replan-rate",
      "label": "Combat replanning obeys the declared tactical rate",
      "detect": "combatRate",
      "severity": "warning",
      "explanation": "A 25 Hz tactical planner should not silently become an every-physics-tick planner whenever combat is active."
    }
  ]
}
