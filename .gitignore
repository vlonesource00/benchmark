# Benchmark-owned subject checkouts can contain large source trees and dependencies.
subjects/*
!subjects/.gitkeep
subjects/*/node_modules/
subjects/*/.npm/

# Runs are reproducible artifacts but are intentionally not committed by default.
results/*
!results/.gitkeep

# Local web build/runtime output.
node_modules/
dist/

# Local editor and OS files.
.DS_Store
Thumbs.db
